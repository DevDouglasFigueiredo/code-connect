PORT=3000
# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
# Generate a local secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=code_connect
DB_USER=code_connect
# Match MYSQL_PASSWORD in the root .env.
DB_PASSWORD=replace-with-local-app-password
